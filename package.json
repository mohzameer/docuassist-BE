{
    "name": "drawdocs-api",
    "version": "1.0.0",
    "description": "DrawDocs API Service",
    "type": "module",
    "scripts": {
        "dev": "sls offline start",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "jest",
        "deploy:dev": "sls deploy --stage dev",
        "deploy:prod": "sls deploy --stage prod",
        "remove:dev": "sls remove --stage dev",
        "remove:prod": "sls remove --stage prod"
    },
    "dependencies": {
        "@aws-sdk/client-cognito-identity-provider": "^3.515.0",
        "@aws-sdk/client-dynamodb": "^3.515.0",
        "@aws-sdk/client-s3": "^3.515.0",
        "@aws-sdk/lib-dynamodb": "^3.515.0",
        "aws-jwt-verify": "^4.0.1",
        "ulid": "^2.3.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "esbuild": "^0.19.12",
        "eslint": "^8.56.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "prettier": "^3.2.5",
        "serverless": "^3.38.0",
        "serverless-dotenv-plugin": "^6.0.0",
        "serverless-esbuild": "^1.54.6",
        "serverless-offline": "^13.3.3"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}